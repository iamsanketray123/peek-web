// Peek Web — Prisma schema.
// Auth (users, sessions) is handled by Supabase Auth (auth.users).
// We store only application data here, keyed by the Supabase user id (UUID).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (pgbouncer) for serverless runtime
  directUrl = env("DIRECT_URL")   // direct connection for migrations / db push
}

/// A keyword a user has saved/tracked from the Keyword Explorer.
model SavedKeyword {
  id             String   @id @default(cuid())
  userId         String // Supabase auth.users.id
  term           String
  country        String   @default("us")
  popularity     Int?
  difficulty     Int?
  opportunity    Int?
  classification String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  metricSnapshots KeywordMetricSnapshot[]

  @@unique([userId, term, country])
  @@index([userId])
}

/// A point-in-time snapshot of keyword metrics (popularity, difficulty, opportunity).
/// Collected daily by the cron job and on each user search, building trend data.
model KeywordMetricSnapshot {
  id              String       @id @default(cuid())
  savedKeywordId  String
  savedKeyword    SavedKeyword @relation(fields: [savedKeywordId], references: [id], onDelete: Cascade)
  popularity      Int?
  difficulty      Int?
  opportunity     Int?
  capturedAt      DateTime     @default(now())

  @@index([savedKeywordId, capturedAt])
}

/// An App Store app a user is tracking (Phase 3 — App Tracking).
model TrackedApp {
  id           String       @id @default(cuid())
  userId       String // Supabase auth.users.id
  appleId      String // iTunes trackId
  name         String
  developer    String
  iconUrl      String?
  primaryGenre String?
  country      String       @default("us")
  ratingCount  Int          @default(0)
  avgRating    Float        @default(0)
  price        String?
  releaseDate  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  keywords     AppKeyword[]
  competitors  CompetitorApp[]
  seedStatus   String       @default("pending") // "pending" | "seeding" | "completed" | "error"
  experiments KeywordExperiment[]
  experimentEvents ExperimentEvent[]
  acquisitionDays AcquisitionDay[]

  @@unique([userId, appleId, country])
  @@index([userId])
}

/// An observational metadata experiment, scoped to the parent app's storefront.
model KeywordExperiment {
  id            String @id @default(cuid())
  appId         String
  app           TrackedApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  name          String
  hypothesis    String
  keywords      String[]
  before        String
  after         String
  baselineStart DateTime @db.Date
  startDate     DateTime @db.Date
  endDate       DateTime @db.Date
  settleDays    Int @default(3)
  status        String @default("running")
  conclusion    String @default("")
  createdAt     DateTime @default(now())
  @@index([appId, startDate])
}

/// Explicit user-reported promotion, metadata, or no-promotion windows.
model ExperimentEvent {
  id           String @id @default(cuid())
  appId        String
  app          TrackedApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  kind         String
  title        String
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  cooldownDays Int @default(3)
  url          String @default("")
  notes        String @default("")
  createdAt    DateTime @default(now())
  @@index([appId, startDate])
}

/// User-entered ASC first-time download counts; null means not reported, NOT zero.
model AcquisitionDay {
  id              String @id @default(cuid())
  appId           String
  app             TrackedApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  date            DateTime @db.Date
  searchDownloads Int?
  webReferrals    Int?
  appReferrals    Int?
  browseDownloads Int?
  sourceNote      String
  updatedAt       DateTime @updatedAt
  @@unique([appId, date])
}

/// A competitor app associated with a tracked workspace app.
model CompetitorApp {
  id           String     @id @default(cuid())
  trackedAppId String
  trackedApp   TrackedApp @relation(fields: [trackedAppId], references: [id], onDelete: Cascade)
  appleId      String
  name         String
  developer    String
  iconUrl      String?
  createdAt    DateTime   @default(now())
  snapshots    CompetitorRankSnapshot[]

  @@unique([trackedAppId, appleId])
  @@index([trackedAppId])
}

/// A keyword tracked for a specific app, with the latest computed metrics.
model AppKeyword {
  id               String         @id @default(cuid())
  appId            String
  app              TrackedApp     @relation(fields: [appId], references: [id], onDelete: Cascade)
  term             String
  popularity       Int?
  difficulty       Int?
  difficultyLabel  String?
  metricsUpdatedAt DateTime?
  createdAt    DateTime       @default(now())
  snapshots    RankSnapshot[]
  competitorSnapshots CompetitorRankSnapshot[]

  @@unique([appId, term])
  @@index([appId])
}

/// A point-in-time rank of an app for one of its tracked keywords.
/// position is null when the app isn't found in the search results (not ranked).
model RankSnapshot {
  id           String     @id @default(cuid())
  appKeywordId String
  appKeyword   AppKeyword @relation(fields: [appKeywordId], references: [id], onDelete: Cascade)
  position     Int? // 1-based rank; null = not ranked
  checkedAt    DateTime   @default(now())

  @@index([appKeywordId, checkedAt])
}

/// A point-in-time rank of a competitor app for one of the main app's tracked keywords.
model CompetitorRankSnapshot {
  id              String        @id @default(cuid())
  competitorId    String
  competitor      CompetitorApp @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  appKeywordId    String
  appKeyword      AppKeyword    @relation(fields: [appKeywordId], references: [id], onDelete: Cascade)
  position        Int? // 1-based rank; null = not ranked
  checkedAt       DateTime      @default(now())

  @@index([competitorId, checkedAt])
  @@index([appKeywordId, checkedAt])
}
